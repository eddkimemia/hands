# Admin dashboard password (CHANGE THIS before deploying)
ADMIN_PASSWORD=change-me-now

# Secret used to sign admin sessions (any long random string)
ADMIN_SESSION_SECRET=please-change-this-to-a-long-random-string

# Public site URL (used for sitemap / canonical / Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics (optional) — e.g. G-XXXXXXXXXX for Google Analytics 4.
NEXT_PUBLIC_GA_ID=

# PostgreSQL connection.
# Leave unset in development → an embedded PostgreSQL server is started
# automatically on localhost:5433 (data stored in ./.pgdata).
# For production, point this at your managed Postgres (Neon, Supabase, RDS…):
# DATABASE_URL=postgres://user:password@host:5432/handsofhope

# Payment provider keys are intentionally NOT configured yet.
# See src/lib/payments.ts for the provider adapter architecture (M-Pesa ready).

# Receipt emails (order confirmations with PDF invoice attached)
# Works with any SMTP provider. Without these, invoices stay downloadable-only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Ishara Charity <receipts@isharacharity.org>"
